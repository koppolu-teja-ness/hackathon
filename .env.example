# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional if using temporary credentials:
AWS_SESSION_TOKEN=

# --- Bedrock model IDs ---
BEDROCK_CHAT_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# --- Crawl limits (Dev A) ---
MAX_PAGES=20
MAX_DEPTH=3
REQUEST_TIMEOUT=10
MAX_RESPONSE_BYTES=2000000
CRAWL_DELAY_SECONDS=0.5
USER_AGENT=HackathonRAGBot/0.1 (+https://example.com/bot)

# --- Storage ---
DATA_DIR=data/sessions

# --- Chunking (Dev A) ---
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
